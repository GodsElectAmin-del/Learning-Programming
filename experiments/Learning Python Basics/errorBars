import matplotlib.pyplot as plt
import numpy as np

def errorbars():   
    data_1 = [1, 3, 2, 3, 2, 3, 2]
    data_2 = [3, 2, 1, 2, 3, 2, 1]
    mean_1 = np.mean(data_1)
    mean_2 = np.mean(data_2)
    combined_mean = [mean_1, mean_2]
    stander_div1 = np.std(data_1)
    standert_div2 = np.std(data_2)
    combined_std = [stander_div1, standert_div2]
    plt.bar([1,2], combined_mean, yerr = combined_std)
    plt.xticks([1,2],["bar", "bar 2"])
    plt.legend(["mean 1", "mean 2"])
errorbars()
plt.show()
