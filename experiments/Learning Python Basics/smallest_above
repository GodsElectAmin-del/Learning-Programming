def smallest_above(numbers, threshold):
    newList = list(range(0,len(numbers)-threshold))
    i = 0
    ChoosenInt = 0
    while threshold < len(numbers):
        newList[i] = numbers[threshold]
        threshold = threshold + 1
        i = i+1
    for index in newList:
        if newList[index] > ChoosenInt:
            ChoosenInt = newList[index]
    return newList, ChoosenInt
print(smallest_above([1,2,3,4,5,], 3))

