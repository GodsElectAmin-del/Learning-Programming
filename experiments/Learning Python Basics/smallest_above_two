def smallest_above(numbers, threshold):
    bigNumbers = None
    for i in range(len(numbers)):
        if i > threshold and (bigNumbers is None or i < bigNumbers):
            bigNumbers = i
    if bigNumbers == None:
        raise ValueError('There is no smalles_above')
    return bigNumbers
print(smallest_above([1,2,3,4,5,6,7],6))
